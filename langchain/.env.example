# ===== LangChain 示例 · 环境变量参考模板 =====
# 使用方法：
#   Windows:  copy .env.example .env
#   macOS/Linux:  cp .env.example .env
# 然后把下方占位符替换为你的真实值。
#
# 注意：真实 .env 包含密钥，已被 .gitignore 忽略、不会提交；
# 本文件 .env.example 是占位符模板，随项目提交，仅作参考。

# API 密钥（必填）
OPENAI_API_KEY=your-api-key
# API 地址，OpenAI 兼容接口（必填）
OPENAI_API_BASE=your-api-url
# 模型名（可选，默认 deepseek-v4-flash）
OPENAI_MODEL=deepseek-v4-flash

# ---- LangSmith 全链路追踪（可选，取消注释并按需填写） ----
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=your-langsmith-api-key
# LANGSMITH_PROJECT=langchain-examples
